# Copy to .env and fill in. Everything is optional except where noted.

# --- Server ---------------------------------------------------------------
PORT=8787
# Which contractor profile the app shows (config/<id>.json)
PROFILE_ID=lm-electric
# If set, the app asks for this code once and the API rejects requests without it.
ACCESS_CODE=
# Protects POST /api/admin/scan. Use a long random string.
ADMIN_TOKEN=

# --- Daily scan -----------------------------------------------------------
# Runs inside the server process, Pacific time. Leave blank to disable.
SCAN_DAILY_AT=06:15

# --- Database -------------------------------------------------------------
# Blank = local embedded Postgres (PGlite) stored in ./data/pglite.
# Set to a Supabase/Postgres connection string for production / multi-process.
DATABASE_URL=
# Set to 1 if your Postgres host needs SSL but has no CA bundle you can pin (Supabase pooler).
PG_SSL_NO_VERIFY=

# --- Sources --------------------------------------------------------------
# Free key: sam.gov -> sign in -> Account Details -> Public API Key. Blank = SAM.gov source skipped.
SAM_API_KEY=
# Comma list to limit sources, e.g. "ngem,questcdn". Blank = all enabled sources.
SOURCES=
# Polite scraper identity (shows up in agency server logs).
CONTACT_EMAIL=

# --- Daily digest email (Resend) -----------------------------------------
# Blank = digest is written to ./data/digest-latest.html and printed instead of emailed.
RESEND_API_KEY=
DIGEST_FROM="BidSwipe <bids@yourdomain.com>"
# Comma-separated recipients for the L&M digest
DIGEST_TO=
# Public URL of the app, used for links in the email
APP_URL=http://localhost:8787

# --- Accounts (v1) --------------------------------------------------------
# single (default when blank) = one profile from config/<PROFILE_ID>.json — the pilot, exactly as before.
# accounts = people sign up and sign in; each account has its own business profile in the database.
AUTH_MODE=
# Set to 1 to treat every account as plan "pilot": all Pro features on, no billing.
DEMO_MODE=
# Optional "Continue with Google" etc. through Supabase Auth. Both must be set, or it stays off.
# Supabase dashboard -> Project Settings -> API: the project URL and the anon (public) key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Phone alerts: web push (v1) ------------------------------------------
# Generate a key pair once with: npx web-push generate-vapid-keys
# Both keys must be set, or push stays off (the in-app inbox and the email digest still work).
# The private key is a secret: keep it here, never in the repo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who push services can contact about this sender: mailto:you@yourdomain.com or your https:// URL.
# Blank = mailto:CONTACT_EMAIL, else APP_URL.
VAPID_SUBJECT=

# --- Market data (v1) -----------------------------------------------------
# Wages and material price indexes come from the BLS Public Data API. It works without a key
# (25 queries a day; a full refresh uses 15). A free key lifts that to 500 a day:
# https://data.bls.gov/registrationEngine/ (renew it once a year). Keep it here, never in the repo.
BLS_API_KEY=
# Optional hard stop on BLS queries per refresh (blank = no extra limit).
BLS_MAX_QUERIES=
# Federal award prices come from api.usaspending.gov and need no key.
# Refresh: npm run market:refresh -- --states=NV,CA --months=24   (or POST /api/admin/market/refresh)
