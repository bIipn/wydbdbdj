# Copy to .env and fill in. Everything is optional except where noted.

# --- Server ---------------------------------------------------------------
PORT=8787
# Which contractor profile the app shows (config/<id>.json)
PROFILE_ID=lm-electric
# If set, the app asks for this code once and the API rejects requests without it.
ACCESS_CODE=
# Protects the operator routes under /api/admin/ (run a scan now, set an account's plan).
# Use a long random string. Blank = those routes refuse everyone.
ADMIN_TOKEN=
# Only when a reverse proxy on ANOTHER machine or network sits in front (Docker network, a PaaS):
# its address or CIDR range, comma-separated, e.g. 10.0.0.0/8. The sign-in rate limit then counts
# each caller, not the proxy. Leave blank for a proxy on this machine (the Caddy setup in this repo).
TRUST_PROXY=

# --- Daily scan -----------------------------------------------------------
# Runs inside the server process, Pacific time. Leave blank to disable.
SCAN_DAILY_AT=06:15

# --- Database -------------------------------------------------------------
# Blank = local embedded Postgres (PGlite) stored in ./data/pglite.
# Set to a Supabase/Postgres connection string for production / multi-process.
DATABASE_URL=
# Embedded database folder (default ./data/pglite). One process per folder.
DATA_DIR=
# Set to 1 if your Postgres host needs SSL but has no CA bundle you can pin (Supabase pooler).
PG_SSL_NO_VERIFY=

# --- Sources --------------------------------------------------------------
# SAM.gov (federal bids). Default "bulk": one download a day of SAM's public Contract Opportunities file
# (~222 MB, no key, no daily limit, every user served from the same download). "api" = the old search API,
# which needs SAM_API_KEY: a personal key allows 10 calls a day and must be renewed every 90 days.
SAM_SOURCE=
SAM_API_KEY=
# A live bulk download with fewer rows than this is treated as cut off and fails loudly (default 20000;
# the 2026-11-13 file has 72,318 rows). Only change it if SAM's file really shrinks.
SAM_BULK_MIN_ROWS=
# Comma list to limit sources, e.g. "ngem,questcdn". Blank = all enabled sources.
# "fixtures" = offline: every scan replays the real pages saved in test/fixtures (captured 2026-11-11)
# and nothing touches the network. For trying the app or a demo, never for real use: those bids go stale.
SOURCES=
# Polite scraper identity (shows up in agency server logs).
CONTACT_EMAIL=

# --- Daily digest email (Resend) -----------------------------------------
# Blank = digest is written to ./data/digest-latest.html and printed instead of emailed.
RESEND_API_KEY=
DIGEST_FROM="BidSwipe <bids@yourdomain.com>"
# Comma-separated recipients for the L&M digest
DIGEST_TO=
# Public URL of the app, used for links in the email
APP_URL=http://localhost:8787
# Sender of mail to account holders: today the "forgot password" link (accounts mode). It needs RESEND_API_KEY
# above and an address on a domain verified with Resend, e.g. "BidSwipe <hello@yourdomain.com>".
# Blank = DIGEST_FROM is used. With no RESEND_API_KEY, no reset email can be sent: the sign-in screen then
# says "Password reset by email is not available yet" and POST /api/auth/forgot answers 503.
EMAIL_FROM=

# --- Accounts (v1) --------------------------------------------------------
# single (default when blank) = one profile from config/<PROFILE_ID>.json — the pilot, exactly as before.
# accounts = people sign up and sign in; each account has its own business profile in the database.
# Serve accounts mode over https (APP_URL below starting with https://) so the session cookie is marked Secure.
AUTH_MODE=
# Set to 1 to treat every account as plan "pilot": all Pro features on, no billing.
DEMO_MODE=
# Optional "Continue with Google" etc. through Supabase Auth. Both must be set, or it stays off.
# Supabase dashboard -> Project Settings -> API: the project URL and the anon (public) key.
# The Supabase project must:
#   - be used by BidSwipe only (any app sharing the project could sign its users in here);
#   - sign with asymmetric keys, ES256 or RS256 (Auth -> Signing keys). A project still on the legacy
#     HS256 secret publishes no keys and every sign-in is refused;
#   - keep "Confirm email" and "Secure email change" ON. Accounts are matched on the email address.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Promo codes that unlock BidSwipe Pro for free (accounts mode, DEMO_MODE off). Shown on the web and in the
# Microsoft Store build; never in an iOS App Store build (Apple guideline 3.1.1).
# Comma-separated CODE:pro[:maxUses][:expiresISO], e.g. TEST-PROMO:pro:25:2027-03-01. Case and spaces don't
# matter. Give every real code a use limit and an expiry (the log warns about one without).
# Set the REAL code only on the host (Vercel env / the server's .env), never here or anywhere in the repo:
# anyone with the repo would get Pro. In a shell .env, quote a code with '&': PROMO_CODES='A&Btest:pro:25'.
# Blank = no code box, and POST /api/promo/redeem answers 403.
PROMO_CODES=

# --- Phone alerts: web push (v1) ------------------------------------------
# Generate a key pair once with: npm run push:keys
# Both keys must be set, or push stays off (the in-app inbox and the email digest still work).
# The private key is a secret: keep it here, never in the repo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who push services can contact about this sender. It has to be mailto:you@yourdomain.com or an
# https:// URL: push services reject anything else, so an http:// value turns push off (one log line).
# Blank = mailto:CONTACT_EMAIL, else APP_URL — which only works when APP_URL is https.
VAPID_SUBJECT=
# How the open app hears about new alerts. "stream" (default on a server that stays up): one live
# connection per open app, instant. "poll" (default on Vercel, where VERCEL is set): the app asks the
# inbox about once a minute while it is on screen, and reloads its feed after each scan.
REALTIME_MODE=
# Poll interval in milliseconds (at least 15000; default 60000).
REALTIME_POLL_MS=

# --- Serverless host (Vercel) ---------------------------------------------
# The host's scheduler calls GET /api/cron/scan, /api/cron/market and /api/cron/tick (vercel.json) with
# "Authorization: Bearer <CRON_SECRET>". Blank = those routes do not exist (404). Vercel also needs
# DATABASE_URL (a real Postgres): the embedded database would start empty on every instance.
CRON_SECRET=

# --- Market data (v1) -----------------------------------------------------
# Wages and material price indexes come from the BLS Public Data API. It works without a key
# (25 queries a day; a full refresh uses 15). A free key lifts that to 500 a day:
# https://data.bls.gov/registrationEngine/ (renew it once a year). Keep it here, never in the repo.
BLS_API_KEY=
# Optional hard stop on BLS queries per refresh (blank = no extra limit).
BLS_MAX_QUERIES=
# Federal award prices come from api.usaspending.gov and need no key.
# Refresh: npm run market:refresh -- --states=NV,CA --months=24   (or POST /api/admin/market/refresh)
# Daily market refresh inside the server, Pacific time ("HH:MM", e.g. 03:40). Blank = off (refresh by
# hand with POST /api/admin/market/refresh). Each run pulls awards for every state a profile works in,
# BLS wages + price indexes, then the price agent compares before/after and alerts Pro profiles:
#   - a watched price index or wage with a NEW period that moved at least PRICE_WATCH_THRESHOLD_PCT
#   - a new federal award whose solicitation number matches a bid someone saved, or a similar job nearby
# One run a day is plenty (USAspending and BLS are free public services). A failed run is logged and
# shows in GET /api/market/watch; it never stops the bid scan or the server.
MARKET_REFRESH_AT=
# How far a watched series must move from one period to the next before it alerts anyone, in percent.
# A product setting, not a market fact (default 2). Users only ever see "up 2.4%".
PRICE_WATCH_THRESHOLD_PCT=

# --- Local jobs marketplace (accounts mode) ----------------------------------
# People post jobs, others bid in the app, the lowest bid wins at closing, and the winner has a few days to
# make contact. PAYMENTS ARE OFF: fees are only recorded (job_fees, status 'recorded'), never collected.
# A value outside its limits stops the server at start-up with a sentence saying which and why.
# Blank = the default. Percentages may have decimals (2.5).
# No-show fee: what a winner who never made contact, or gave the job back, owes. Default 5, 0 to 10.
JOB_NO_SHOW_FEE_PCT=
# The part of that fee that goes to the poster whose time was wasted. Default 2, at most the no-show fee.
JOB_POSTER_SHARE_PCT=
# BidSwipe's small service fee when both sides confirm an agreement. Default 1, 0 to 3.
JOB_SERVICE_FEE_PCT=
# Days the winner has from the award to make contact and work it out. Default 7, 1 to 30.
JOB_CONTACT_DAYS=
# Largest bid or budget, in cents. Default 25000000 ($250,000.00); the smallest is always $20.00.
JOB_MAX_CENTS=
