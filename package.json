{
  "name": "bidswipe",
  "version": "0.1.0",
  "description": "Bid scanner + swipe app for contractors. v0 is tuned for L&M Electric (Gardnerville, NV).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "scan": "tsx src/cli/scan.ts",
    "scan:prod": "node dist/cli/scan.js",
    "demo:snapshot": "tsx src/cli/snapshot.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/static": "^10.1.10",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10"
  }
}
