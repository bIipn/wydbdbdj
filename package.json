{
  "name": "bidswipe",
  "version": "0.1.0",
  "description": "Bid scanner + swipe app for contractors. v0 is tuned for L&M Electric (Gardnerville, NV).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "scan": "tsx src/cli/scan.ts",
    "scan:prod": "node dist/cli/scan.js",
    "demo:snapshot": "tsx src/cli/snapshot.ts",
    "simulate": "tsx src/cli/simulate.ts",
    "simulate:cost": "tsx src/cli/simulate-cost.ts",
    "market:refresh": "tsx src/cli/market.ts",
    "market:refresh:prod": "node dist/cli/market.js",
    "push:keys": "web-push generate-vapid-keys",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/static": "^10.1.10",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "web-push": "^4.0.0",
    "zipcodes": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  }
}
