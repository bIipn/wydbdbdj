{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastify",
  "buildCommand": "npm run build && rm -rf public && cp -r web public",
  "regions": ["sfo1"],
  "functions": {
    "server.js": { "maxDuration": 300, "includeFiles": "config/**" }
  },
  "crons": [
    { "path": "/api/cron/market", "schedule": "40 11 * * *" },
    { "path": "/api/cron/scan", "schedule": "20 13 * * *" }
  ]
}
