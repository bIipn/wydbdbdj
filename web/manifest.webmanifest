  "shortcuts": [
    {
      "name": "Home",
      "short_name": "Home",
      "description": "Your best matching bids, as a list or one at a time",
      "url": "./?view=home",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Search",
      "short_name": "Search",
      "description": "Every open bid that fits, with filters and sorting",
      "url": "./?view=browse",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Saved",
      "short_name": "Saved",
      "description": "The bids you saved",
      "url": "./?view=saved",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Jobs",
      "short_name": "Jobs",
      "description": "Local jobs: post one, or bid on one near you",
      "url": "./?view=jobs",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Alerts",
      "short_name": "Alerts",
      "description": "New matches, reminders and news on your local jobs",
      "url": "./?view=alerts",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
    { "src": "icons/screenshots/narrow-home.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Home: your matching public bids as a list, with a government price index at the top" },
    { "src": "icons/screenshots/narrow-search.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Search: every open public bid that fits, with filters and sorting" },
